# Copy to scripts/release.local.env (git-ignored) and fill in. No passwords here: see scripts/release-env.sh.

# Where simplmaker.com is hosted: an SFTP login by SSH key.
SFTP_USER=your-sftp-user
SFTP_HOST=ssh.example.com
SFTP_KEY=$HOME/.ssh/your_deploy_key

# The notarytool keychain profile:  xcrun notarytool store-credentials <name> ...
NOTARY_PROFILE=your-notary-profile

# The account name the Sparkle update-signing key was made under (generate_keys --account <name>). Default: SimplMaker.
# SPARKLE_ACCOUNT=SimplMaker

# Only for scripts/publish-site.sh --protect: the SFTP home as the web server sees it (sftp's pwd), plus the .htpasswd name.
# HTPASSWD_PATH=/absolute/path/to/your/sftp/home/.htpasswd-simplmaker
