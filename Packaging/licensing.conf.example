# Copy to Packaging/licensing.conf (and commit it: neither value is secret) once the product exists on Polar.
# See docs/LICENSING-SETUP.md.
#
# Your Polar organization's id (Polar dashboard: Settings, shown as "Organization ID"), a UUID.
POLAR_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# The checkout link for this major version's product (a Polar "checkout link", https://buy.polar.sh/...).
BUY_URL=https://buy.polar.sh/polar_cl_XXXXXXXX
# The id of that product's License Keys benefit. A key for another major version is turned away. Polar's public page
# lists it under products > benefits (no purchase needed):
#   curl -s https://api.polar.sh/v1/customer-portal/organizations/<organization slug> | python3 -m json.tool
POLAR_BENEFIT_ID=00000000-0000-0000-0000-000000000000
# The major version this build sells licenses for. Each major version has its own product, trial and update feed
# (updates/v1/, updates/v2/, ...), so version 1 keeps working, with its updates, when version 2 comes out.
# When you start version 2: make a new product on Polar, change the four values above and this one to 2, set VERSION to 2.0.0.
LICENSE_GENERATION=1

# Testing only: Polar's sandbox (own organization, own products, test card 4242 4242 4242 4242). Leave unset for
# the real thing; scripts/bundle-app.sh --release refuses to build with it set. Can also be given as an env variable.
# POLAR_API_BASE=https://sandbox-api.polar.sh
